# Copy to .env and change every value. .env is git-ignored, and the settings file denies Claude Code reading it
# with its file tools and commands such as cat. Keep the sa password off trainee laptops.
# SQL Server needs at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=Change-Me-Admin-2026!
HK_RO_PASSWORD=Change-Me-ReadOnly-2026!
HK_REPLAY_PASSWORD=Change-Me-Replay-2026!
